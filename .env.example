# Public canonical deployment origin, no trailing slash.
SITE_URL=http://localhost:3000
# Never commit .env.local or put secret values in public-prefixed variables.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Required for production contact rate limiting on Vercel; provider-managed Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional HTTPS JSON feed for runtime external-publication records.
PUBLICATIONS_FEED_URL=
